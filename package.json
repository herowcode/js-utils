    "@size-limit/preset-small-lib": "14.2.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.8.0",
    "@types/node": "25.3.3",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "jsdom": "26.1.0",
    "pino": "9.14.0",
    "pino-pretty": "^11.3.0",
    "publint": "0.3.25",
    "size-limit": "14.2.0",
    "tsup": "8.5.1",
    "typescript": "^5.2.2",
    "vite": "7.3.5",
    "vitest": "4.1.11"
