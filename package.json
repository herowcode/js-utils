    "@testing-library/react": "16.3.0",
    "@testing-library/react-hooks": "8.0.1",
    "@types/node": "25.3.3",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitest/coverage-v8": "3.2.7",
    "@vitest/ui": "3.2.7",
    "jest-environment-jsdom": "30.1.2",
    "jsdom": "26.1.0",
    "next": "15.5.20",
    "pino-pretty": "^11.3.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsup": "8.5.1",
    "typescript": "^7.0.2",
    "vitest": "3.2.7"
  },
  "author": {
    "name": "Judson Junior",
