  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node scripts/sync-exports.cjs",
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --diagnostic-level=error --no-errors-on-unmatched",
    "lint:fix": "biome check --write --unsafe",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:exports": "node scripts/verify-exports.cjs",
    "test:coverage": "vitest run --coverage",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm build && pnpm test:exports",
    "version:patch": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm build && pnpm test:exports && npm version patch && git push && git push --tags",
    "version:minor": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm build && pnpm test:exports && npm version minor && git push && git push --tags",
    "version:major": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm build && pnpm test:exports && npm version major && git push && git push --tags"
  },
  "keywords": [
    "utils",
    "utilities",
    "date",
    "string",
    "debounce",
    "throttle",
    "typescript",
    "dayjs"
  ],
  "dependencies": {
