  "files": [
    "dist",
    "llms.txt"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prebuild": "node scripts/sync-exports.cjs",
    "build": "tsup --config tsup.config.ts",
    "check": "biome check . && tsc --noEmit",
    "lint": "biome check --write --unsafe && tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:exports": "node scripts/verify-universal-source.cjs && node scripts/verify-exports.cjs && node scripts/verify-docs.cjs",
    "test:package": "publint --strict && attw --pack . --profile node16",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "docs:index": "node scripts/generate-index.cjs --write",
    "changeset": "changeset",
    "prepublishOnly": "pnpm build && pnpm test:exports"
  },
  "keywords": [
    "utils",
    "utilities",
    "date",
    "string",
    "debounce",
    "throttle",
    "typescript",
    "dayjs"
  ],
  "dependencies": {
    "dayjs": "^1.11.10"
  },
  "peerDependencies": {
    "pino": "^9.5.0 || ^10.0.0",
    "pino-pretty": ">=11"
  },
  "peerDependenciesMeta": {
    "pino": {
      "optional": true
    },
    "pino-pretty": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
